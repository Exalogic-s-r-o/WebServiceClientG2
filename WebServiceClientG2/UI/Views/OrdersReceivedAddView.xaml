<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WebServiceClientG2.UI.Views.OrdersReceivedAddView"
             xmlns:local="clr-namespace:WebServiceClientG2.UI.ViewModels"
             xmlns:views="clr-namespace:WebServiceClientG2.UI.Views"
             xmlns:models="clr-namespace:Exa.OBERON.ServicesGen2.Client.Models.OrdersReceived;assembly=Exa.OBERON.ServicesGen2.Client"
             x:DataType="local:OrdersReceivedViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <ScrollView>
        <Grid RowSpacing="15" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--Toolbar-->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                
                <Label MaxLines="1" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center"
                       Text="Orders received Add" TextColor="{StaticResource PrimaryTextColor}" FontSize="24" FontFamily="RobotoRegular" />

                
            </Grid>

            <!-- Order received add -->
            <toolkit:Expander Grid.Row="1">
                <toolkit:Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="↓" HorizontalTextAlignment="Center" Style="{StaticResource expanderHeaderArrow}"/>
                        <Label Grid.Column="1" Text="stock/order-received/add" HorizontalTextAlignment="Center" Style="{StaticResource expanderHeaderCaption}"/>
                        <Label Grid.Column="2" Text="↓" HorizontalTextAlignment="Center" Style="{StaticResource expanderHeaderArrow}"/>
                    </Grid>
                </toolkit:Expander.Header>

                <Grid Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- GUID -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Padding="10,0,0,5" Grid.Row="0" Text="GUID" FontSize="14" TextColor="{StaticResource PrimaryLightColor}" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Entry Grid.Column="0" Text="{Binding OrderReceivedAddGUID}" Style="{StaticResource EntryColorTheme}" TextColor="{StaticResource PrimaryTextColor}" />
                            <Button Grid.Column="1" Text="Generate" Command="{Binding GUIDGenerateCommand}" />
                        </Grid>
                    </Grid>

                    <!-- Number -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Padding="10,0,0,5" Grid.Row="0" Text="Number" FontSize="14" TextColor="{StaticResource PrimaryLightColor}" />
                        <Entry Grid.Row="1" Text="{Binding OrderReceivedNumber}" Style="{StaticResource EntryColorTheme}" TextColor="{StaticResource PrimaryTextColor}" />
                    </Grid>

                    <!-- DateDelivery -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Padding="10,0,0,5" Grid.Row="0" Text="Delivery date and time" FontSize="14" TextColor="{StaticResource PrimaryLightColor}" />
                        <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <DatePicker Date="{Binding OrderReceivedDateDeliveryDate}" Format="yyyy-MM-dd" />
                            <TimePicker Time="{Binding OrderReceivedDateDeliveryTime}" />
                        </StackLayout>
                    </Grid>

                    <!-- BusinessPartner Name -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Padding="10,0,0,5" Grid.Row="0" Text="Business partner" FontSize="14" TextColor="{StaticResource PrimaryLightColor}" />
                        <Entry Grid.Row="1" Text="{Binding OrderReceivedBusinessPartnerName}" Style="{StaticResource EntryColorTheme}" TextColor="{StaticResource PrimaryTextColor}" />
                    </Grid>

                    <!-- DateReservation -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Padding="10,0,0,5" Grid.Row="0" Text="Reservation date" FontSize="14" TextColor="{StaticResource PrimaryLightColor}" />
                        <DatePicker Grid.Row="1" Date="{Binding OrderReceivedDateReservationDate}" Format="yyyy-MM-dd" />
                    </Grid>

                    <!-- Notice -->
                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Padding="10,0,0,5" Grid.Row="0" Text="Note" FontSize="14" TextColor="{StaticResource PrimaryLightColor}" />
                        <Entry Grid.Row="1" Text="{Binding OrderReceivedNotice}" Style="{StaticResource EntryColorTheme}" TextColor="{StaticResource PrimaryTextColor}" />
                    </Grid>

                    <!-- Items section -->
                    <Grid Grid.Row="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Text="Items" FontSize="16" FontAttributes="Bold" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Entry Grid.Column="0" Placeholder="Name" Text="{Binding NewItemName}" Style="{StaticResource EntryColorTheme}" />
                            <Entry Grid.Column="1" Placeholder="Amount" Text="{Binding NewItemAmount}" Style="{StaticResource EntryColorTheme}" />
                            <Entry Grid.Column="2" Placeholder="Unit" Text="{Binding NewItemUnit}" Style="{StaticResource EntryColorTheme}" />
                            <Entry Grid.Column="3" Placeholder="Reserved" Text="{Binding NewItemReserved}" Style="{StaticResource EntryColorTheme}" />
                            <Entry Grid.Column="4" Placeholder="Price" Text="{Binding NewItemPrice}" Style="{StaticResource EntryColorTheme}" />
                            <Button x:Name="btnAddItem" Grid.Column="5" Text="Add" Clicked="OnAddItemClicked" />
                        </Grid>

                        <CollectionView Grid.Row="2" ItemsSource="{Binding OrderReceivedItems}" Margin="0,8,0,0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderReceivedItem">
                                    <Border Padding="8" Margin="4" Stroke="{StaticResource Gray200}" StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackLayout Spacing="2">
                                                <Label Text="Name" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryLightColor}" />
                                                <Label Text="{Binding Name}" FontSize="14" TextColor="{StaticResource PrimaryTextColor}" />
                                                <Label Text="Amount" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryLightColor}" />
                                                <Label Text="{Binding Amount}" FontSize="14" TextColor="{StaticResource PrimaryTextColor}" />
                                                <Label Text="Reserved" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryLightColor}" />
                                                <Label Text="{Binding AmountReserved}" FontSize="14" TextColor="{StaticResource PrimaryTextColor}" />
                                            </StackLayout>

                                            <Button Grid.Column="1" Text="Remove" VerticalOptions="Center" Clicked="OnRemoveItemClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                             </CollectionView.ItemTemplate>
                         </CollectionView>
                     </Grid>

                    <Button Grid.Row="7" Text="Create" Command="{Binding OrderReceived_AddCommand}" Margin="10" />
                 </Grid>
             </toolkit:Expander>

         </Grid>
     </ScrollView>

</ContentView>
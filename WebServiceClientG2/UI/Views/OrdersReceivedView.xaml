<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WebServiceClientG2.UI.Views.OrdersReceivedView"
             xmlns:local="clr-namespace:WebServiceClientG2.UI.ViewModels"
             x:DataType="local:OrdersReceivedViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <ScrollView>
        <Grid RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" HeightRequest="62">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Label
                    MaxLines="1"
                    Grid.Column="1"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Text="Orders received"
                    TextColor="{StaticResource PrimaryTextColor}"
                    FontSize="24"
                    FontFamily="RobotoRegular"/>
            </Grid>

            <!-- Placeholder content -->
            <Label Grid.Row="1" Text="Placeholder for Orders received operations" Margin="10"/>
        </Grid>
    </ScrollView>

</ContentView>

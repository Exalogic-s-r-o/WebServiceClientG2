<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WebServiceClientG2.UI.Views.OrdersIssuedView"
             xmlns:local="clr-namespace:WebServiceClientG2.UI.ViewModels"
             x:DataType="local:OrdersIssuedViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <ScrollView>
        <Grid RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Label
                    MaxLines="1"
                    Grid.Column="1"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Text="ORDERS Issued"
                    TextColor="{StaticResource PrimaryTextColor}"
                    FontSize="24"
                    FontFamily="RobotoRegular"/>

            </Grid>

            <!-- OrdersIssued_Add -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <ContentView 
                     Grid.Column="1"
                     Grid.Row ="0"
                     x:Name="ctw_OrdersIssued_Add">   
                </ContentView>
       
            </Grid>

            <!-- OrdersIssued_SummaryItems -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <ContentView 
                   Grid.Column="1"
                   Grid.Row ="0"
                   x:Name="ctw_OrdersIssued_SummaryItems">
                </ContentView>

            </Grid>
            
        </Grid>
    </ScrollView>

</ContentView>
